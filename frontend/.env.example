[TEMPLATE]
# SENSOURA - Frontend configuration
# Copy to .env and fill in your values. Vite only exposes VITE_* vars.

# ==========================================
# Backend API + realtime endpoints
# ==========================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ==========================================
# Firebase Authentication (Email/Password + GitHub OAuth)
# Firebase Console > Project settings > General > Web app config.
# This API key is public client config; never put service-account secrets here.
# These public web-app values are injected at Vite build time.
# Keep the GitHub OAuth Client Secret in Firebase Console, never in VITE_* vars.
# ==========================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ==========================================
# Product analytics (PostHog)
# Project API key: PostHog > Project settings > Project API key.
# Leave the key empty to switch analytics off for this build.
# Use https://eu.i.posthog.com for EU-hosted projects.
# ==========================================
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
