# SENSOURA Frontend - Production Build
# NASA Competition Grade

# ==========================================
# Build stage
# ==========================================
FROM node:22-alpine AS builder
WORKDIR /app
ARG VITE_BASE_PATH=/
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY}
ENV VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN}
ENV VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID}

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

# ==========================================
# Production stage - Nginx
# ==========================================
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Create non-root user
RUN addgroup -g 1001 -S sensoura && \
    adduser -S sensoura -u 1001 -G sensoura && \
    chown -R sensoura:sensoura /usr/share/nginx/html && \
    chown -R sensoura:sensoura /var/cache/nginx && \
    chown -R sensoura:sensoura /etc/nginx && \
    touch /var/run/nginx.pid && \
    chown -R sensoura:sensoura /var/run/nginx.pid

USER sensoura

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
