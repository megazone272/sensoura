#pragma once

#include <Arduino.h>

// Copy this file to secrets.h (ignored by Git) and replace every placeholder.
static const char* SENSOURA_WIFI_SSID = "REPLACE_WITH_WIFI_SSID";
static const char* SENSOURA_WIFI_PASSWORD = "REPLACE_WITH_WIFI_PASSWORD";

// Public HTTPS origin of the maintained TLS reverse proxy; no trailing slash.
static const char* SENSOURA_API_BASE_URL = "https://your-public-dashboard.example";
static const char* SENSOURA_DEVICE_ID = "sensoura-esp32-01";
// Generate a unique random bearer token with at least 32 characters and set the
// exact same value as DEVICE_AUTH_TOKEN in the ignored backend/.env.
static const char* SENSOURA_DEVICE_AUTH_TOKEN = "REPLACE_WITH_UNIQUE_RANDOM_DEVICE_TOKEN_32_CHARS_OR_MORE";

// Replace the placeholder with the PEM root CA that validates the reverse
// proxy's TLS certificate chain. An invalid or empty value fails closed.
static const char SENSOURA_ROOT_CA_PEM[] PROGMEM = R"PEM(
-----BEGIN CERTIFICATE-----
REPLACE_WITH_THE_TRUSTED_ROOT_CA_PEM
-----END CERTIFICATE-----
)PEM";
