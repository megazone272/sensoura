# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo
.vite/

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
serviceAccountKey.json
**/serviceAccountKey.json
*serviceAccount*.json
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
**/coverage/

# ML artifacts
backend/models/*.bin
backend/models/*.h5
backend/models/*.json
!backend/models/.gitkeep

# Calibration artifacts (generated by `npm run ai:train`; see
# backend/models/calibration/README.md). The directory itself is kept through
# its README, the generated JSON files are not committed.
backend/models/calibration/*.json

# Paired reference measurements (operator-supplied lab data; the format is
# documented in backend/datasets/calibration/README.md). The README is
# committed, the measurement files are not.
backend/datasets/calibration/*.json
backend/datasets/calibration/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Agent / tooling scratch
.freebuff/
Temp/
tmp/
