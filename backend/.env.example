# SENSOURA - NASA Competition Grade Configuration
# Copy to .env and fill in your values

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ==========================================
# Firebase (Optional for local dev)
# Get from: Firebase Console > Project Settings > Service Accounts
# ==========================================
FIREBASE_PROJECT_ID=on-an-official-team
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@on-an-official-team.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://on-an-official-team-default-rtdb.europe-west1.firebasedatabase.app
# Fallback: path to the service account JSON (used when the 3 vars above are empty)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ==========================================
# Redis (for BullMQ job queue)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# MQTT (for ESP32 direct communication)
# ==========================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ==========================================
# AI/ML Configuration
# ==========================================
AI_MODEL_PATH=./models
AI_PREDICTION_INTERVAL_MS=300000
AI_CONFIDENCE_THRESHOLD=0.85

# ==========================================
# AI Pipeline (data-integration / decision / prediction)
# Runs as its own process: `npm run pipeline` (or `npm run pipeline:once`).
# See docs/ai-pipeline.md for the full reference.
# ==========================================
PIPELINE_ENABLED=true
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=3100
# PIPELINE_DRY_RUN=true          # compute everything, write nothing
# PIPELINE_ADMIN_TOKEN=...       # protects POST /run/decision and /run/prediction
# PIPELINE_ALLOW_MEMORY_FALLBACK=true  # non-persistent local runs

# Site coordinates. Leave unset: external sources stay DISABLED and no
# location is inferred.
# GREENHOUSE_LAT=30.0444
# GREENHOUSE_LON=31.2357
GREENHOUSE_TIMEZONE=Africa/Cairo
# GREENHOUSE_ID=sensoura-greenhouse-01

# Database paths
SENSOR_DATA_PATH=/Sensoura/sensorData
SYSTEM_PATH=/Sensoura/system
AI_DATA_ROOT=/Sensoura/AI_Data
AI_SUGGESTIONS_PATH=/Sensoura/AI_Suggestions
AI_PREDICTIONS_PATH=/Sensoura/AI_Predictions

# Pre-existing prediction node. New predictions are APPENDED here with the
# legacy field names (type, predictedValue, confidence, predictionTime);
# existing records are never modified or deleted.
AI_LEGACY_PREDICTIONS_PATH=/Sensoura/aiPredictions
AI_LEGACY_PREDICTIONS_WRITE=true

# Schedules
DECISION_INTERVAL_MS=1800000
PREDICTION_INTERVAL_MS=86400000

# Equipment actually present in firmware/src/main.ino
EQUIPMENT_PUMP=true
EQUIPMENT_BUZZER=true
EQUIPMENT_VENTILATION=false
EQUIPMENT_VENTILATION_FAN=false
EQUIPMENT_HUMIDIFIER_FAN=false
EQUIPMENT_SUPPLEMENTAL_LIGHT=false
# The pipeline is advisory only: it never actuates the pump.
AI_ALLOW_IRRIGATION_RECOMMENDATIONS=false

# Potato agronomy. Thresholds must come from a cited, cultivar-specific
# source; they are not invented by the pipeline.
# POTATO_CULTIVAR=Spunta
# POTATO_PLANTING_DATE=2026-09-15
# POTATO_GDD_EMERGENCE=150
# POTATO_GDD_FLOWERING=350

# ==========================================
# Sensor calibration
# ==========================================
# Calibration models are produced OFFLINE by `npm run ai:train` from paired
# reference measurements, and are then READ by the pipeline. The repository
# ships no artifact: without one the raw sensor values are used unchanged and
# the recommendations report indoorSensorStatus=none.
# Format: backend/datasets/calibration/README.md
# AI_CALIBRATION_ENABLED=true
# AI_CALIBRATION_ARTIFACT_DIR=models/calibration
# Directory with the paired reference datasets used by `npm run ai:train`.
# AI_TRAINING_DATASET_DIR=datasets/calibration

# ==========================================
# Security
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
API_RATE_LIMIT=100

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# NASA Competition Metadata
# ==========================================
MISSION_NAME=SENSOURA
MISSION_PHASE=LUNAR_ANALOG
TEAM_ID=TEAM-MISSION-49