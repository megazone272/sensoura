# SENSOURA - NASA Competition Grade Configuration
# Copy to .env and fill in your values

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ==========================================
# Firebase (Optional for local dev)
# Get from: Firebase Console > Project Settings > Service Accounts
# ==========================================
FIREBASE_PROJECT_ID=on-an-official-team
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@on-an-official-team.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://on-an-official-team-default-rtdb.europe-west1.firebasedatabase.app
# Fallback: path to the service account JSON (used when the 3 vars above are empty)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ==========================================
# Redis (for BullMQ job queue)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# MQTT (for ESP32 direct communication)
# ==========================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ==========================================
# AI/ML Configuration
# ==========================================
AI_MODEL_PATH=./models
AI_PREDICTION_INTERVAL_MS=300000
AI_CONFIDENCE_THRESHOLD=0.85

# ==========================================
# Security
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
API_RATE_LIMIT=100

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# NASA Competition Metadata
# ==========================================
MISSION_NAME=SENSOURA
MISSION_PHASE=LUNAR_ANALOG
TEAM_ID=TEAM-MISSION-49