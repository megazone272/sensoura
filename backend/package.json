{
  "name": "sensoura-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "SENSOURA Backend — Smart Agriculture Monitoring System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build-cpanel.mjs",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:pipeline": "vitest run __tests__/ai-pipeline",
    "pipeline": "tsx src/ai/pipeline/index.ts",
    "pipeline:once": "tsx src/ai/pipeline/index.ts --once",
    "inspect-legacy": "tsx scripts/inspect-legacy-predictions.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/push-schema.ts",
    "ai:train": "tsx src/ai/train.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "date-fns": "^3.6.0",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "ml-regression": "^6.3.0",
    "nodemailer": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "globals": "^15.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
