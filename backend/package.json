{
  "name": "sensoura-backend",
  "version": "2.0.0",
  "description": "NASA Competition Grade - Sensoura Smart Agriculture IoT Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/push-schema.ts",
    "ai:train": "tsx src/ai/train.ts"
  },
  "dependencies": {
    "@fastify/compress": "^6.5.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "axios": "^1.7.4",
    "bullmq": "^5.12.3",
    "danfojs-node": "^1.2.0",
    "date-fns": "^3.6.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.5.0",
    "ioredis": "^5.4.1",
    "ml-matrix": "^6.12.1",
    "ml-regression": "^5.0.0",
    "mqtt": "^5.7.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@tensorflow/tfjs-node@4.22.0": true,
    "@tensorflow/tfjs-node@3.21.1": true
  }
}
