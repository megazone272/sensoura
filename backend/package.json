{
  "name": "sensoura-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "SENSOURA Backend — Smart Agriculture Monitoring System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build-cpanel.mjs",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:pipeline": "vitest run __tests__/ai-pipeline",
    "pipeline": "tsx src/ai/pipeline/index.ts",
    "pipeline:once": "tsx src/ai/pipeline/index.ts --once",
    "inspect-legacy": "tsx scripts/inspect-legacy-predictions.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/push-schema.ts",
    "ai:train": "tsx src/ai/train.ts"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^10.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "date-fns": "^3.6.0",
    "fastify": "^4.29.1",
    "firebase-admin": "^12.2.0",
    "ml-regression": "^6.3.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "globals": "^15.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}